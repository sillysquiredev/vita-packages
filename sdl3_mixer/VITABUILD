pkgname=sdl3_mixer
pkgver=3.2.4
pkgrel=1
url='https://github.com/libsdl-org/SDL_mixer'
license=('Zlib')
source=("https://github.com/libsdl-org/SDL_mixer/releases/download/release-${pkgver}/SDL3_mixer-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "SDL3_mixer-${pkgver}"
  mkdir build && cd build
  cmake .. -DCMAKE_TOOLCHAIN_FILE=$VITASDK/share/vita.toolchain.cmake -DCMAKE_INSTALL_PREFIX=$prefix -DCMAKE_BUILD_TYPE=Release -DSDLMIXER_EXAMPLES=OFF -DSDLMIXER_TESTS=OFF
  make -j$(nproc)
}

package () {
  cd "SDL3_mixer-${pkgver}"
  cd build
  make DESTDIR=$pkgdir install
}
